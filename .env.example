# Paytag — ortam değişkenleri ŞABLONU
#
# Bu dosya commit EDİLİR ve sadece placeholder içerir.
# Gerçek değerler:
#   - local geliştirme  -> web/.env.local  (gitignore'da)
#   - production        -> Vercel > Settings > Environment Variables
#
# NEXT_PUBLIC_ öneki olan her değişken TARAYICI BUNDLE'INA girer.
# Bir sırra asla NEXT_PUBLIC_ öneki verme.

# ---------- Stellar ----------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_ESCROW_CONTRACT_ID=C-your-contract-id-here
NEXT_PUBLIC_USDC_SAC_ID=C-your-usdc-sac-id-here

# ---------- Verifier (SUNUCU TARAFI — asla client'a sızmaz) ----------
# ed25519 seed, base64. Üretmek için: pnpm run verifier:keygen
# Karşılık gelen PUBLIC key kontrata init() ile verilir.
VERIFIER_SECRET=your-ed25519-seed-here
NEXT_PUBLIC_VERIFIER_PUBLIC_KEY=your-verifier-public-key-here

# ---------- GitHub OAuth ----------
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ---------- Veritabanı ----------
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# ---------- Oturum ----------
SESSION_SECRET=your-32-byte-random-string-here
