# Paytag — environment variable TEMPLATE
#
# This file IS committed and CONTAINS NO VALUES. It only lists which variables
# are required. Not even an example value is written: a fake value placed in a
# template can be mistaken for a real one once copied, and it keeps the
# scanners needlessly busy too.
#
# Real values live in:
#   - local development  -> web/.env.local  (gitignored)
#   - production         -> Vercel > Settings > Environment Variables
#
# Every variable prefixed with NEXT_PUBLIC_ ENTERS THE BROWSER BUNDLE.
# Never give a secret the NEXT_PUBLIC_ prefix.

# ---------- Stellar ----------
# Network name: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=
# Soroban RPC endpoint
NEXT_PUBLIC_STELLAR_RPC_URL=
# Address of the escrow contract (C...)
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
# Native XLM's Stellar Asset Contract. The default asset, because native XLM
# needs no trustline — an issued asset cannot even be held until the recipient
# opens one, which is a wall in front of exactly the people this is for.
# The id is derived from the network passphrase, so read it, do not remember it:
#   stellar contract id asset --asset native --network testnet
NEXT_PUBLIC_XLM_SAC_ID=
# OPTIONAL second asset. Leave empty and the UI offers XLM only. The escrow
# takes the token address as an argument, so it accepts any SEP-41 token
# without a contract change.
#
# This has to be the SAME USDC the anchor ramps, or the off-ramp cannot take
# what the escrow paid out: an asset is its code AND its issuer, and two USDCs
# from two issuers are two different assets that cannot be exchanged for each
# other. The value below is the TR mock anchor's USDC, derived with
#   stellar contract id asset \
#     --asset USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5 \
#     --network testnet
NEXT_PUBLIC_USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# OPTIONAL, and only for reading history. An earlier USDC, from an issuer of
# our own, that payments on the deployed contract are still denominated in.
# It is never offered to a sender — no anchor ramps it, so it could only ever
# become a balance with nowhere to go — but naming it keeps those payments
# readable instead of printing an amount with no unit beside it.
NEXT_PUBLIC_USDC_LEGACY_SAC_ID=CBU7HRUSXSVPI7QHA73G67UDRQTKSEOICFHWOMWSPOZ2S3R3DIWUCPKI

# ---------- Verifier (SERVER SIDE — never leaks to the client) ----------
# ed25519 seed, 64 hex digits. To generate:
#   node scripts/paytag.mjs keygen
VERIFIER_SECRET=
# The corresponding public key, printed alongside the seed by `keygen`.
# Handed to the contract via init().
NEXT_PUBLIC_VERIFIER_PUBLIC_KEY=

# ---------- Supabase (identity verification and sessions) ----------
# Optional: leave these empty and the app still sends and refunds money. Only
# claiming needs an account. Setup steps: docs/SETUP-AUTH.md
#
# The GitHub OAuth client id and secret are NOT here — they go into the
# Supabase dashboard (Authentication > Providers > GitHub). Supabase performs
# the token exchange, so the OAuth secret never touches this app.
#
# Project URL and anon key are public by design: everything they can read is
# bounded by the row level security policies in db/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service role key BYPASSES row level security. Server side only. Its one
# job is writing an identity row after OAuth — the one write a user must never
# be able to make for themselves, since that write IS the proof of ownership.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- X / Twitter (optional second identity) ----------
# Set to 1 only once the Supabase project has the X provider configured with a
# client id and secret (docs/SETUP-AUTH.md §6). Nothing in the browser can see
# whether that is done, and an enabled button that dead-ends at Supabase's
# error page is worse than a disabled one that says why.
NEXT_PUBLIC_X_ENABLED=
# LOWERS THE GUARANTEE. Set to 1 to take the X handle from the identity row
# Supabase wrote at sign-in instead of asking X ourselves. Only for deployments
# whose X app has no API access — X charges per profile read. `identity_data` is
# provider-filled and not writable with auth.updateUser, so this is "trust
# Supabase's fetch instead of ours", not "trust the user". Leave empty to
# require our own verification, which is the default and the stronger path.
X_TRUST_PROVIDER_IDENTITY=

# ---------- The X handle check on /send (optional, and it costs money) ----------
# THE ONLY THING IN THIS FILE THAT SPENDS MONEY ON BEING USED. X charges $0.010
# per username lookup against a credit balance, with no free allowance, and the
# call needs an APP-ONLY bearer token — the user's OAuth token cannot make it.
#
# Leave X_API_BEARER empty and the feature is simply off: /send behaves exactly
# as it did before it existed, saying it cannot confirm an X account and linking
# the profile. Nothing breaks and nothing is spent.
X_API_BEARER=
# Required alongside it. Salts the sha256 of the caller's IP and wallet address
# before they are counted in `x_lookups`, so the table can bound a bill without
# becoming a record of who looked up whom. Any long random string:
#   openssl rand -hex 32
# Changing it resets every in-flight per-caller window. That is harmless; the
# monthly cap counts rows, not callers.
RATE_LIMIT_IP_SALT=
# Hard ceiling on PAID lookups per calendar month, for the whole deployment.
# Defaults to the 1,000 in web/lib/config.ts — about $10 — when unset. This is
# the number that actually bounds the bill: the per-caller limit (50 per three
# hours) stops one person going haywire, but multiplied out over a month one
# caller alone could still reach $120. Raise it when the meter says to, not
# before.
X_LOOKUP_MONTHLY_CAP=
